# Signalpost Evidence Engine — environment
#
# Copy to .env and fill in. NOTHING here is strictly required: with no keys at
# all the engine still produces full registry-sourced profiles, because the
# design rule is registry first, web second, LLM last.
#
#   cp .env.example .env

# ─── models ──────────────────────────────────────────────────────────────────
# Gap filling. Cheap, fast, structured output. Called once per company at most,
# and only for the fields the rule extractor could not resolve.
SIGNALPOST_MODEL_GAP=claude-haiku-4-5-20251001

# Conflict resolution. Called rarely, only when two sources disagree on a field
# the pipeline already holds. If it cannot pick a winner the field is dropped.
SIGNALPOST_MODEL_VERIFY=claude-sonnet-5-5

# ─── api keys ────────────────────────────────────────────────────────────────
# Anthropic. Required for the two model roles above. Without it the pipeline
# runs rules-only and records "llm disabled" in the run report.
ANTHROPIC_API_KEY=

# Brave Search. Used in two places: website discovery for companies whose
# register record has no `hjemmeside`, and as the *primary* engine for the live
# research agent (`run.py live`). Billed per query. Without it the live agent
# falls back to keyless engines (DuckDuckGo, Mojeek) and, always, to the
# Wikipedia API — so the demo searches with no key, just less reliably.
BRAVE_API_KEY=

# ─── free sources (no key needed, listed for completeness) ───────────────────
# Enhetsregisteret   https://data.brreg.no/enhetsregisteret/api       NLOD 2.0
# Regnskapsregisteret https://data.brreg.no/regnskapsregisteret/     NLOD 2.0
# GLEIF              https://api.gleif.org/api/v1                    free
# Wikidata           https://query.wikidata.org/sparql               CC0

# ─── behaviour ───────────────────────────────────────────────────────────────
# Concurrent companies. 4 is comfortable; above 8 the shared crawl politeness
# delay becomes the bottleneck rather than the network.
SIGNALPOST_WORKERS=4

# Request budget. The brief caps a run at 2,000 requests / 45 min. The soft
# limit winds the run down gracefully; the hard limit raises.
SIGNALPOST_SOFT_LIMIT=1700
SIGNALPOST_HARD_LIMIT=2000

# Identifier lookups (GLEIF, Wikidata) are abandoned after this many seconds so
# a slow third party can never stall a company in the batch.
SIGNALPOST_ENRICH_TIMEOUT=8

# Page fetch timeout, seconds.
SIGNALPOST_HTTP_TIMEOUT=20

# ─── toggles ─────────────────────────────────────────────────────────────────
# 1 = registry mirror only, no network calls at all (used by `make demo`).
SIGNALPOST_OFFLINE=0

# 1 = skip the web layer entirely, even online.
SIGNALPOST_NO_WEB=0

# 1 = rules and verifier only, never call a model.
SIGNALPOST_NO_LLM=0

# 1 = also fetch annual accounts from Regnskapsregisteret (optional figures).
SIGNALPOST_FINANCIALS=0

# 1 = print only the cost block at the end.
SIGNALPOST_QUIET=0

# Identify yourself to the registers. Replace the contact with your own.
SIGNALPOST_UA=SignalpostEvidenceEngine/1.0 (+https://github.com/signalpost; contact: submit@builderr.ai)
